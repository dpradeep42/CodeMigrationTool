{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "ServerConfiguration": {
    "SessionTimeoutMinutes": 30,
    "MaxConcurrentSessions": 10,
    "ExecutionTimeoutSeconds": 30,
    "SandboxMemoryLimitBytes": 536870912,
    "SandboxCpuLimit": 1,
    "WarmPoolSize": 2,
    "DefaultRuntime": "dotnet"
  }
}
