FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build

WORKDIR /src

# Copy the agent project and build it
COPY src/CodeMigrationTool.Agent/ CodeMigrationTool.Agent/
COPY src/CodeMigrationTool.Shared/ CodeMigrationTool.Shared/

RUN dotnet publish CodeMigrationTool.Agent/CodeMigrationTool.Agent.csproj \
    -c Release -o /agent

# Runtime image
FROM mcr.microsoft.com/dotnet/aspnet:8.0

# Run as non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /agent
COPY --from=build /agent .

# The target application will be mounted at /app (read-only)
VOLUME /app

# gRPC port (configurable via GRPC_PORT env var)
ENV ASPNETCORE_URLS=http://+:50100
ENV GRPC_PORT=50100

EXPOSE 50100

USER appuser

ENTRYPOINT ["dotnet", "CodeMigrationTool.Agent.dll"]
